{
  "name": "obsidian-multi-ai-assistant",
  "version": "1.1.0",
  "description": "Obsidian plugin: index notes + uploaded files, ask Gemini, Groq, OpenAI, or Claude. Supports the Gemini and Claude CLIs.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "openai": "^6.33.0",
    "pdf-parse": "^1.1.1",
    "pdfjs-dist": "^3.11.174"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/pdf-parse": "^1.1.4",
    "esbuild": "0.17.3",
    "obsidian": "latest",
    "tslib": "2.4.0",
    "typescript": "4.7.4"
  }
}
